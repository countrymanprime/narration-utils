{
  "roots": [
    ".editorconfig",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".husky",
    ".prettierignore",
    ".prettierrc.json",
    ".vscode",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "apps",
    "commitlint.config.cjs",
    "config",
    "docs",
    "integrations",
    "knip.jsonc",
    "libs",
    "lint-staged.config.mjs",
    "nx.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "project.json",
    "pyproject.toml",
    "scripts",
    "sidecars",
    "stylua.toml",
    "tests",
    "tools",
    "uv.lock"
  ],
  "enforceRetired": true,
  "historical": [
    "docs/adr/",
    "docs/research/repo-layout-alignment.md",
    "docs/prds/implementation-plan.md",
    "tools/ui-atlas-kit/CHANGELOG.md",
    "pnpm-lock.yaml",
    "scripts/ci/layout.json",
    "scripts/ci/layout.test.mjs"
  ],
  "patterns": [
    "(?<![A-Za-z0-9_.-])shared[\\/]",
    "(?<![A-Za-z0-9_.-])shell\\\\",
    "(?:-C|--dir|working-directory:|directory:)\\s+/?shell(?![A-Za-z0-9_./-])",
    "['\"]shared['\"]",
    "[,(]\\s*['\"]shell['\"]\\s*[,)]",
    "['\"]tools['\"]\\s*,\\s*['\"](?:manuscript-|transcript-)"
  ],
  "renames": [
    { "from": "tools/manuscript-guide/daws/audacity", "to": "integrations/audacity/manuscript-guide" },
    { "from": "tools/transcript-compare/daws/audacity", "to": "integrations/audacity/transcript-compare" },
    { "from": "tools/manuscript-guide/core/tests", "to": "sidecars/manuscript-guide/tests" },
    { "from": "tools/manuscript-teleprompter/core/tests", "to": "sidecars/manuscript-teleprompter/tests" },
    { "from": "tools/transcript-compare/core/tests", "to": "sidecars/transcript-compare/tests" },
    { "from": "tools/manuscript-guide", "to": "sidecars/manuscript-guide" },
    { "from": "tools/manuscript-teleprompter", "to": "sidecars/manuscript-teleprompter" },
    { "from": "tools/transcript-compare", "to": "sidecars/transcript-compare" },
    { "from": "shared/audacity", "to": "integrations/audacity" },
    { "from": "shared/config", "to": "config" },
    { "from": "shared/python", "to": "libs/python" },
    { "from": "shared/reaper", "to": "integrations/reaper" },
    { "from": "shared/test-fixtures", "to": "tests/fixtures" },
    { "from": "shared/ui", "to": "apps/ui" },
    { "from": "shell/", "to": "apps/desktop/" }
  ]
}
