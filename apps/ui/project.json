{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "narration-utils-ui",
  "projectType": "application",
  "tags": ["toolchain:node"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run lint:ci"
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run architecture"
      },
      "metadata": {
        "description": "The import-graph rules of apps/ui (.dependency-cruiser.mjs, ADR 0062): primitives are leaves, only src/api reaches wailsjs, Base UI only in primitives."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run format:check"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/coverage-gate.mjs vitest {projectRoot}"
      }
    },
    "test-node": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test {projectRoot}/scripts/*.test.mjs"
      },
      "metadata": {
        "description": "node:test suites of the plain-Node scripts under apps/ui/scripts (the docs/ui generator)."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "visual": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run screenshots"
      }
    },
    "aria": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run aria"
      },
      "metadata": {
        "description": "The role trees of the dialogs, the slide-over and the navigation (tests/aria, ADR 0065). Run by the ui-visual CI job after the visual suite."
      }
    },
    "atlas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run atlas"
      }
    }
  },
  "sourceRoot": "apps/ui/src"
}
