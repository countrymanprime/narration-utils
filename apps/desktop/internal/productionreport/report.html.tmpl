<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{.App.Name}} {{.App.Version}}">
<title>Production status report</title>
<style>
:root { color-scheme: light dark; --text: #1d1d1f; --muted: #5c5c66; --line: #d6d6de; --bg: #ffffff; --band: #f4f4f7; --danger: #a4161a; }
@media (prefers-color-scheme: dark) { :root { --text: #ececf1; --muted: #a8a8b3; --line: #3a3a44; --bg: #16161a; --band: #202027; --danger: #ff8a8a; } }
body { margin: 0 auto; max-width: 60rem; padding: 1.5rem 1rem 3rem; font: 15px/1.5 system-ui, "Segoe UI", sans-serif; color: var(--text); background: var(--bg); }
h1 { font-size: 1.6rem; margin: 0 0 .25rem; } h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; border-bottom: 1px solid var(--line); padding-bottom: .25rem; }
p, li { max-width: 55rem; } .muted { color: var(--muted); } .overdue { color: var(--danger); font-weight: 600; }
.notice { background: var(--band); border-left: 4px solid var(--line); padding: .75rem 1rem; }
ul.plain { list-style: none; padding: 0; margin: 0; }
ul.plain li { border-bottom: 1px solid var(--line); padding: .35rem 0; }
</style>
</head>
<body>
<header>
<h1>Production status report</h1>
<p class="muted">Generated {{.GeneratedAt}} by {{.App.Name}} {{.App.Version}}</p>
<p class="notice">{{.Notice}}</p>
</header>

<h2>Book</h2>
<ul>
<li>{{.Book.Chapters}} chapter(s), {{.Book.FinalizedChapters}} finalized, {{.Book.WordCount}} words.</li>
<li>Finished audio: {{clock .Book.RecordedSeconds}} ({{.Book.MeasuredChapters}} of {{.Book.Chapters}} chapters measured).</li>
<li>Hours logged: {{optClock .Book.HoursLogged}}.</li>
<li>Hours per finished hour (book-wide): {{optPfh .Book.BookPFH}}.</li>
</ul>

<h3>Hours by stage</h3>
<ul class="plain">
{{range stageHours .Book.HoursByStage}}<li>{{.}}</li>
{{else}}<li class="muted">Nothing logged yet.</li>
{{end}}
</ul>

<h2>Deadline</h2>
{{with .Deadline}}<p>{{.Date}} ({{days .DaysLeft}})</p>{{else}}<p class="muted">No deadline set.</p>{{end}}

<h2>Milestones</h2>
<ul class="plain">
{{range .Milestones}}<li{{if .Overdue}} class="overdue"{{end}}>{{.Name}} — {{.DueDate}} ({{days .DaysLeft}}){{with .Note}} · {{.}}{{end}}</li>
{{else}}<li class="muted">No milestones set.</li>
{{end}}
</ul>

<h2>Chapter readiness</h2>
<ul class="plain">
{{range readiness .Readiness}}<li>{{.}}</li>
{{end}}
</ul>

<h2>Rate</h2>
<p>Contracted amount: {{optAmount .Rate.ContractedAmount}}. Effective rate: {{optAmount .Rate.EffectiveRate}} / hour.</p>
<p class="muted">{{.Rate.Note}}</p>

<h2>Privacy</h2>
<p class="muted">{{.Privacy.Note}}</p>
</body>
</html>
