<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{.App.Name}} {{.App.Version}}">
<title>Delivery report</title>
<style>
:root { color-scheme: light dark; --text: #1d1d1f; --muted: #5c5c66; --line: #d6d6de; --bg: #ffffff; --band: #f4f4f7; --danger: #a4161a; }
@media (prefers-color-scheme: dark) { :root { --text: #ececf1; --muted: #a8a8b3; --line: #3a3a44; --bg: #16161a; --band: #202027; --danger: #ff8a8a; } }
body { margin: 0 auto; max-width: 72rem; padding: 1.5rem 1rem 3rem; font: 15px/1.5 system-ui, "Segoe UI", sans-serif; color: var(--text); background: var(--bg); }
h1 { font-size: 1.6rem; margin: 0 0 .25rem; } h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; border-bottom: 1px solid var(--line); padding-bottom: .25rem; }
p, li { max-width: 60rem; } .muted { color: var(--muted); } .open { color: var(--danger); font-weight: 600; }
.notice { background: var(--band); border-left: 4px solid var(--line); padding: .75rem 1rem; }
.scroll { overflow-x: auto; } table { border-collapse: collapse; width: 100%; font-size: .9rem; }
th, td { border-bottom: 1px solid var(--line); padding: .35rem .5rem; text-align: left; vertical-align: top; }
th { background: var(--band); } td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
code { font-family: ui-monospace, "Cascadia Mono", monospace; font-size: .85em; overflow-wrap: anywhere; }
ul.plain { list-style: none; padding: 0; margin: 0; }
</style>
</head>
<body>
<header>
<h1>Delivery report</h1>
<p class="muted">Generated {{.GeneratedAt}} by {{.App.Name}} {{.App.Version}}{{range .Analyzers}} · {{.Name}} analyzer v{{.Version}}{{end}}</p>
<p class="notice">{{.Notice}}</p>
</header>

<h2>Summary</h2>
<ul>
<li>{{.Summary.Files}} file(s): {{.Summary.Measured}} measured, {{.Summary.NotMeasured}} not measured; {{.Summary.Checked}} checked for diagnostics, {{.Summary.NotChecked}} not checked.</li>
<li><span{{if .Summary.OpenFindings}} class="open"{{end}}>{{.Summary.OpenFindings}} open finding(s)</span> of {{.Summary.Findings}} (open means not dismissed). By review: {{counts .Summary.ByReview}}. By severity: {{counts .Summary.BySeverity}}.</li>
<li>Scope: {{.Scope.Description}}</li>
<li>Privacy: {{.Privacy.Note}}</li>
</ul>

<h2>Limits</h2>
<p>{{.Limits.Note}}</p>
{{if .Limits.Metrics}}<ul>{{range .Limits.Metrics}}<li>{{.Label}}: {{limitText .}}</li>{{end}}</ul>{{end}}

<h2>Files</h2>
<div class="scroll"><table>
<thead><tr><th>File</th><th>Status</th><th>Measurements</th><th>Diagnostics</th><th>Fingerprint</th></tr></thead>
<tbody>
{{range .Files}}<tr id="file-{{.Ref}}">
<td><strong>{{.Ref}}</strong> {{.Name}}{{if .Path}}<br><code>{{.Path}}</code>{{end}}</td>
<td{{if .OpenFindings}} class="open"{{end}}>{{statusText .}}</td>
<td>{{if .Measurement.Report}}<ul class="plain">{{range metrics .Measurement.Report}}<li>{{.Label}}: {{.Value}}</li>{{end}}</ul>{{else}}{{.Measurement.Reason}}{{end}}</td>
<td>{{if .Diagnostics.Summary}}<ul class="plain"><li>Clip regions: {{.Diagnostics.Summary.ClipRegions}}</li><li>Level shifts: {{.Diagnostics.Summary.LevelShifts}}</li><li>Silences: {{.Diagnostics.Summary.Silences}}</li><li>Room-tone segments: {{.Diagnostics.Summary.RoomToneSegments}}</li><li>Pacing: {{if eq .Diagnostics.Summary.Pacing.Status "measured"}}measured{{else}}not available{{with .Diagnostics.Summary.Pacing.Reason}} ({{.}}){{end}}{{end}}</li></ul>{{else}}{{.Diagnostics.Reason}}{{end}}</td>
<td>{{with .Measurement.Fingerprint}}<code title="SHA-256 {{.SHA256}}">{{shortHash .}}</code><br><span class="muted">{{.SizeBytes}} bytes, modified {{.ModifiedAt}}</span>{{else}}<span class="muted">None</span>{{end}}</td>
</tr>
{{else}}<tr><td colspan="5">No files.</td></tr>
{{end}}</tbody>
</table></div>

<h2>Findings</h2>
<p class="muted">Times are from the start of each file. {{.Review.Note}}</p>
<div class="scroll"><table>
<thead><tr><th>Finding</th><th>File</th><th>Time</th><th>Severity</th><th>What was measured</th><th>Review</th></tr></thead>
<tbody>
{{$report := .}}{{range .Findings}}<tr id="finding-{{.ID}}">
<td><strong>{{.Title}}</strong><br><code>{{.ID}}</code><br><span class="muted">{{.Category}} · {{.Analyzer}}{{with .Chapter}} · chapter {{if .Title}}{{.Title}}{{else}}{{.ID}}{{end}}{{end}}</span></td>
<td><a href="#file-{{.File}}">{{.File}}</a> {{fileName $report .File}}</td>
<td class="num">{{timeRange .TimeRange}}</td>
<td>{{severity .Severity}}</td>
<td><ul class="plain">{{range evidence .Evidence}}<li><code>{{.}}</code></li>{{end}}</ul><span class="muted">{{.ConfidenceReason}}</span></td>
<td{{if .Open}} class="open"{{end}}>{{reviewText .Review}}{{with .Review.Note}}<br><span class="muted">{{.}}</span>{{end}}</td>
</tr>
{{else}}<tr><td colspan="6">No findings.</td></tr>
{{end}}</tbody>
</table></div>

<h2>Diagnostics thresholds</h2>
{{if .Diagnostics.Run}}<p>{{sourceKind .Diagnostics.SourceKind}}. {{.Diagnostics.Note}}</p>
<ul>{{range thresholds .Diagnostics.Thresholds}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>{{.Diagnostics.Note}}</p>{{end}}

<h2>Installed assets</h2>
{{if .Assets.Available}}{{if .Assets.Items}}<ul>{{range .Assets.Items}}<li>{{.Name}} ({{.Kind}} <code>{{.ID}}</code>), version {{.Version}}{{with .Publisher}}, {{.}}{{end}}{{with .ProvenanceURL}}, <a href="{{.}}">provenance</a>{{end}}{{with .Path}}<br><code>{{.}}</code>{{end}}</li>{{end}}</ul>{{else}}<p>None installed.</p>{{end}}{{else}}<p>{{.Assets.Note}}</p>{{end}}

<h2>Definitions</h2>
<ul>{{range $key, $text := .Definitions}}<li><code>{{$key}}</code>: {{$text}}</li>{{end}}</ul>
</body>
</html>
