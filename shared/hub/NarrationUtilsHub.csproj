<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe): a GUI-subsystem binary has no console to allocate,
         which is the whole point of this rewrite - see docs/architecture
         notes on the pywebview host's console-flashing subprocess calls. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NarrationUtilsHub</AssemblyName>
    <RootNamespace>NarrationUtilsHub</RootNamespace>
    <!-- Fixed, predictable output location: the Lua launcher and
         Quickstart.ps1 both hardcode this path rather than the
         configuration/RID-dependent default under bin/. -->
    <PublishDir>$(MSBuildProjectDirectory)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

</Project>
