<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe): a GUI-subsystem binary has no console to allocate,
         which is the whole point of this rewrite - see docs/architecture
         notes on the pywebview host's console-flashing subprocess calls. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NarrationUtilsHub</AssemblyName>
    <RootNamespace>NarrationUtilsHub</RootNamespace>
    <!-- Fixed, predictable output location: the Lua launcher and
         Quickstart.ps1 both hardcode this path rather than the
         configuration/RID-dependent default under bin/. -->
    <PublishDir>$(MSBuildProjectDirectory)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel + Minimal API host for the /api/* surface and static file
         serving, replacing the old WebMessageReceived RPC channel and the
         hand-rolled LocalStaticServer. WinExe output is unaffected - this is
         just a FrameworkReference, not the Sdk.Web project template. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Web supplies these as implicit global usings; a
         plain Microsoft.NET.Sdk project with only a FrameworkReference does
         not, so they're listed explicitly instead of switching SDKs (which
         would also change the default OutputType/behavior). -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
