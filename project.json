{
  "name": "narration-utils",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": ".",
  "targets": {
    "build": {
      "command": "pnpm --dir apps/ui run build && pnpm --dir apps/desktop run build"
    },
    "test": {
      "command": "pnpm --dir apps/ui test"
    },
    "lint": {
      "command": "pnpm --dir apps/ui run lint:ci"
    }
  }
}
