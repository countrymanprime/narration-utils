// markdownlint-cli2 configuration (ADR 0415). A starter rule set: the default rules, with line length and every
// rule that fired only on the repo's own deliberate style turned off (checked against the real tree, not guessed).
// `Docs / Markdown lint (changed files)` (.github/workflows/docs.yml) runs this against the Markdown files a pull
// request adds or changes; `pnpm lint:md` / `pnpm lint:md:fix` run the same check locally
// (scripts/ci/changed-markdown.mjs), and lint-staged runs `markdownlint-cli2 --fix` on staged *.md files on commit.
{
  "config": {
    "default": true,
    // Not part of this starter set: the repo writes long lines on purpose (tables, prose with long links).
    "MD013": false,
    // Real tab characters inside fenced code blocks are source code (Go, Makefiles) copied verbatim; only flag a
    // hard tab in prose.
    "MD010": { "code_blocks": false },
    // These fired only on the repo's existing, deliberate style, never on a real mistake, when checked against the
    // whole tree (2026-09-27):
    //  - MD032 blanks-around-lists: the coordinator/worker template style nests list items directly under a bold
    //    lead-in line with no blank line (docs/operations/agent-train.md and its kin).
    //  - MD033 no-inline-html: angle-bracket placeholders in prose (`<file>`, `<title>`, `<PRD path>`) parse as HTML
    //    tags; the repo has no real inline HTML worth linting for.
    //  - MD036 no-emphasis-as-heading: bold lead-in labels ("**Read usage.**") are a deliberate structuring device
    //    across the operations docs, not a heading standing in for one.
    //  - MD038 no-space-in-code: code spans that are deliberately `": "`-shaped (documenting a separator or a
    //    trailing-space convention) read as a mistake to this rule.
    //  - MD041 first-line-heading: the guides under docs/guides/using-the-app/ open with a breadcrumb line, and the
    //    pull request template opens with an H2 by design.
    //  - MD052 reference-links-images: the research and PRD docs cite sources as `[W1][W2]`-style footnote markers
    //    with no link definition, on purpose (a citation key, not a broken reference link).
    //  - MD055/MD056/MD058/MD060 (table pipe style, column count, blank lines around tables, column style): the
    //    ADR template, PRD phase tables and generated docs/ui tables are not formatted to one strict table style.
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD038": false,
    "MD041": false,
    "MD052": false,
    "MD055": false,
    "MD056": false,
    "MD058": false,
    "MD060": false
  },
  // Generated or vendored Markdown: never hand-edited, so never linted.
  "ignores": ["node_modules/**", ".venv/**", "docs/ui/**", "tools/docs-site/build/**", "CHANGELOG.md"]
}
