.venv/
.runtime/
.bootstrap/
.piper/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.vite/
apps/ui/dist/
apps/ui/screenshots/
apps/ui/playwright-report/
apps/ui/test-results/
# A container whose Chromium is older than the pinned Playwright build (mock-match's own MOCK_MATCH_CHROMIUM
# workaround, playwright.mock-match.config.ts) needs the same override for the other suites; kept local, never
# committed, since it names no fixed path any other container would share.
apps/ui/playwright*.local.config.ts
apps/ui/coverage/
.coverage
.coverage.*
.hypothesis/
*.tsbuildinfo
logs/
# Local Claude Code state stays out; the shared settings (plugin marketplaces for cloud sessions) and the
# project skills, agents and path-scoped rules (so cloud sessions and worktrees get them) are tracked.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/rules/
apps/desktop/cmd/narration-utils/frontend/dist/*
!apps/desktop/cmd/narration-utils/frontend/dist/.gitkeep
apps/desktop/cmd/narration-utils/frontend/wailsjs/
apps/desktop/cmd/narration-utils/resources/config/
apps/desktop/cmd/narration-utils/resources/runtime/
apps/desktop/cmd/narration-utils/resources/reaper/
apps/desktop/build/*
# The Windows icon, version and manifest resource wails-build.mjs embeds and removes after the Go build.
apps/desktop/*.syso
!apps/desktop/build/appicon.png
!apps/desktop/build/windows/
apps/desktop/build/windows/*
!apps/desktop/build/windows/icon.ico
# The one installer file that differs from Wails' default. scripts/release/wails-build.mjs renders wails_tools.nsh
# and writes the WebView2 bootstrapper beside it on every installer build.
!apps/desktop/build/windows/installer/
apps/desktop/build/windows/installer/*
!apps/desktop/build/windows/installer/project.nsi
.release-build/
.nx/
.test-tmp/
.test-tmp-*/
.tmp-hub-probe/
release-notes.md
target/
!apps/ui/src/components/production/target/
.tools/
.cache/
apps/ui/storybook-static/
tools/docs-site/build/
.lycheecache
apps/ui/playwright.local.config.ts

# The Wails build output (go build in apps/desktop names its binary after the directory)
/apps/desktop/shell
integrations/reaper/narration-utils-app-path.txt
integrations/reaper/narration-utils-app-path.txt.tmp
