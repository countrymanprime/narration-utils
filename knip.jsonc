// Knip: unused files, exports and dependencies (docs/prds/verification-and-code-health-tooling.prd.md, phases 7 and 8).
// Every entry under `ignore*` says why, so a reader can tell a real exception from a way to make the report quiet.
// Workspaces come from pnpm-workspace.yaml (apps/ui, apps/desktop); the root workspace covers scripts/ and tools/.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The scripts and the kit are entries (nothing imports them), and an entry's exports are normally never reported.
  // Reporting them keeps a helper exported by habit from outliving its last importer.
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      // Plain Node scripts run by hand, by package.json scripts, by workflows and by Nx targets, and their
      // node:test files. None of them is imported, so each is an entry.
      "entry": ["scripts/**/*.mjs", "tools/ui-atlas-kit/scripts/*.mjs", "tools/ui-atlas-kit/plugin/**/*.mjs", "tools/ui-atlas-kit/test/**/*.mjs"],
      "project": ["scripts/**", "tools/**/*.{mjs,js,ts,tsx}"],
      "ignore": [
        // The UI atlas kit ships these files to other repositories by copying them (`ui-atlas scaffold`,
        // `refresh-core`); nothing imports them here. apps/ui holds the live copies, which the drift check
        // in the kit's tests compares byte for byte, and Knip checks those.
        "tools/ui-atlas-kit/plugin/templates/**"
      ],
      "ignoreDependencies": [
        // Loaded by `nx release version` (nx.json "release"), not imported anywhere.
        "@nx/js"
      ],
      "ignoreBinaries": [
        // Go toolchain and Wails CLI, called from scripts/quality.mjs and package scripts. They are not npm packages.
        "gofmt",
        "wails",
        // Installed by .github/actions/setup-playwright (`playwright install`) from the apps/ui dependency.
        "playwright"
      ]
    },
    "apps/ui": {
      "ignore": [
        // Generated by `wails generate module`, imported only through src/api/wailsClient.ts, and rewritten on
        // every host API change. What the UI uses of it is checked by tsc; unused runtime wrappers are Wails's.
        "wailsjs/**"
      ]
    }
  },
  // Exported types in the wire contracts document what the host sends and accepts, whether or not a component
  // names each one yet (the boundary schema PRD turns these into schemas). Unused ones are not dead code.
  "ignoreIssues": {
    "apps/ui/src/api/contracts/**": ["types"],
    // Vendored from tools/ui-atlas-kit core (`refresh-core`) and kept byte-identical: the kit's drift check fails on
    // any edit, and these exports are the kit's API for the visual suite it scaffolds into other repositories.
    "apps/ui/tests/visual/lib/**": ["exports", "types"]
  }
}
