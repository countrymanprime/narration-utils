// Knip: unused files, exports and dependencies (docs/operations/verification-tooling.md, ADR 0045).
// Every entry under `ignore*` says why, so a reader can tell a real exception from a way to make the report quiet.
// Workspaces come from pnpm-workspace.yaml (apps/ui, apps/desktop); the root workspace covers scripts/ and tools/.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The scripts are entries (nothing imports them), and an entry's exports are normally never reported.
  // Reporting them keeps a helper exported by habit from outliving its last importer.
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      // Plain Node scripts run by hand, by package.json scripts, by workflows and by Nx targets, and their
      // node:test files. None of them is imported, so each is an entry.
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**"],
      "ignoreDependencies": [
        // Loaded by `nx release version` (nx.json "release"), not imported anywhere.
        "@nx/js"
      ],
      "ignoreBinaries": [
        // Go toolchain and Wails CLI, called from scripts/quality.mjs, package scripts and the desktop project's
        // Nx targets (`test-schedules` runs `go test`). They are not npm packages.
        "go",
        "gofmt",
        "wails3",
        // Installed by .github/actions/setup-playwright (`playwright install`) from the apps/ui dependency.
        "playwright"
      ]
    },
    "apps/ui": {
      "ignore": [
        // Generated by `wails3 generate bindings` (apps/desktop `pnpm run bindings`), imported only through src/api/wailsClient.ts, and rewritten on
        // every host API change. What the UI uses of it is checked by tsc; unused runtime wrappers are Wails's.
        "wailsjs/**"
      ],
      "ignoreDependencies": [
        // Injected into every captured page by tests/visual/lib/capture.ts, which reads the file through
        // `createRequire(...).resolve('axe-core')` only when axe runs, so no import names it (ADR 0064). It is the
        // version @storybook/addon-a11y already brings.
        "axe-core"
      ]
    }
  },
  // Exported types in the wire contracts document what the host sends and accepts, whether or not a component
  // names each one yet (the boundary schema PRD turns these into schemas). Unused ones are not dead code.
  "ignoreIssues": {
    "apps/ui/src/api/contracts/**": ["types"]
  }
}
