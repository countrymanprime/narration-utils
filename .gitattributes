# Wails emits blank indentation in its generated model stubs. Keep generated
# bindings source-controlled without treating that upstream formatting as a
# handwritten whitespace error.
apps/ui/wailsjs/go/models.ts -whitespace

# Prettier's endOfLine is "lf" (matches what's committed). Force LF checkouts
# on every platform so Windows contributors and CI runners with autocrlf=true
# don't reintroduce CRLF and desync from prettier --check.
apps/ui/src/** text eol=lf
apps/ui/tests/** text eol=lf
apps/ui/*.json text eol=lf
apps/ui/*.ts text eol=lf

# gofmt and stylua both normalize to LF (matches what's committed). Force LF
# checkouts here too, or windows-latest CI runners (autocrlf=true by default)
# checkout CRLF and desync from gofmt -l / stylua --check.
*.go text eol=lf
*.sh text eol=lf
integrations/reaper/** text eol=lf

# Golden payloads written by the Go and Python tests are compared byte for byte (ADR 0069): a CRLF checkout would fail every one.
tests/fixtures/contracts/** text eol=lf

# The demo's sample manuscript is Project Gutenberg's file byte for byte (CRLF line endings and all), so it can be checked
# against the published one; aliceManuscript.ts reads either line ending.
apps/ui/src/api/fixtures/alice-in-wonderland.txt -text

# The constructed heading cases are regenerated byte for byte by their generate.py (LF only); keep checkouts matching it.
tests/fixtures/heading-misreads/*.md text eol=lf
tests/fixtures/heading-misreads/*.txt text eol=lf
